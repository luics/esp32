CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# Wi-Fi/HTTPS 联网固件超过 1 MiB，使用 1500 KiB 单应用分区，仍不启用 OTA。
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
# 重连同一 API 时保存并复用 TLS 会话票据，避免反复完整握手。
CONFIG_ESP_TLS_CLIENT_SESSION_TICKETS=y
CONFIG_BLINK_RGB_GPIO=8
CONFIG_BLINK_MODE_GPIO=5
# 实板原生 USB 日志与 Wokwi UART 日志同时可用。
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
CONFIG_BUTTON_INPUT_GPIO=9
CONFIG_BUTTON_INPUT_RED_GPIO=0
CONFIG_BUTTON_INPUT_BLUE_GPIO=11
CONFIG_BUTTON_INPUT_BLACK_GPIO=1
CONFIG_BUTTON_INPUT_MODE_GPIO=14
# 实板 WS2812 使用 RGB 顺序。
# CONFIG_BLINK_LED_ORDER_GRB is not set
CONFIG_BEEP_GPIO=3
CONFIG_BEEP_FREQUENCY_HZ=2000
# 实板使用侧边排针，避免焊接背面 GPIO6/7 焊盘。
CONFIG_DISPLAY_SCLK_GPIO=21
CONFIG_DISPLAY_MOSI_GPIO=22
CONFIG_DISPLAY_CS_GPIO=18
CONFIG_DISPLAY_DC_GPIO=19
CONFIG_DISPLAY_RST_GPIO=20
# 实板未接电位器时固定 100 ms，避免悬空 ADC 跳档。
# CONFIG_INTERVAL_CONTROL_ENABLED is not set
CONFIG_INTERVAL_CONTROL_ADC_GPIO=4
CONFIG_INTERVAL_CONTROL_SAMPLE_INTERVAL_MS=50

# IoT 私有 CA 对应的新入口；覆盖旧构建中仍使用默认值的域名。
CONFIG_TELEGRAPH_SYNC_BASE_URL="https://telegraph-iot.bryanxu.top"
