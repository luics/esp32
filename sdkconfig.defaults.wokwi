# 叠加在 sdkconfig.defaults 后，只供 Wokwi 独立构建使用。
CONFIG_BLINK_LED_ORDER_GRB=y
CONFIG_BLINK_RGB_GPIO=8
CONFIG_BLINK_MODE_GPIO=5
CONFIG_PIR_SENSOR_GPIO=15
# 仿真开发板不引出 GPIO14，模式按钮仍接 GPIO2。
CONFIG_BUTTON_INPUT_MODE_GPIO=2
# 128x128 黑白 OLED 近似 SSD1327；仅仿真构建启用。
CONFIG_DISPLAY_WOKWI_SH1107=y
# 仿真沿用 diagram.json 的 I2C 接线，覆盖实板侧边 SPI 引脚。
CONFIG_DISPLAY_SCLK_GPIO=6
CONFIG_DISPLAY_MOSI_GPIO=7
# 仿真旋钮已接线，保留四档速度控制。
CONFIG_INTERVAL_CONTROL_ENABLED=y
CONFIG_INTERVAL_CONTROL_ADC_GPIO=4
CONFIG_INTERVAL_CONTROL_SAMPLE_INTERVAL_MS=50
# 避免仿真接收 1440 字节 TCP 段时 ACK 停滞；已验证可发送，仅供 Wokwi。
CONFIG_LWIP_TCP_MSS=536
