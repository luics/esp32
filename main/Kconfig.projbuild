menu "摩斯码电报机配置"

    config BLINK_RGB_GPIO
        int "板载点划 RGB LED 数据引脚"
        range 0 30 if IDF_TARGET_ESP32C6
        range 0 48
        default 8
        help
            板载灯连接 GPIO8：点显示红光，划显示绿光。
            微雪 ESP32-C6-Zero 使用 RGB 顺序，Wokwi 构建使用 GRB。

    config BLINK_MODE_GPIO
        int "外接模式提示 WS2812 数据引脚"
        range 0 30 if IDF_TARGET_ESP32C6
        range 0 48
        default 5
        help
            外接 WS2812 DIN 连接 GPIO5，采用 GRB 顺序。
            每次按下模式按钮闪黄光 200 ms；须与板载灯及其他外设引脚不同。

endmenu
