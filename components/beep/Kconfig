menu "蜂鸣器配置"
    config BEEP_GPIO
        int "无源蜂鸣器输出 GPIO"
        range 0 30 if IDF_TARGET_ESP32C6
        range 0 48
        default 3
        help
            外接无源压电蜂鸣器正极连接此 GPIO，负极连接 GND。
            此引脚须与灯珠、按钮及其他外设引脚不同。

    config BEEP_FREQUENCY_HZ
        int "摩斯码音调频率（Hz）"
        range 100 10000
        default 2000
        help
            LEDC 输出方波驱动无源蜂鸣器，默认使用 2 kHz 提示音。

endmenu
